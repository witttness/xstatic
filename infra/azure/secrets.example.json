{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "oidcIssuerUrl": { "value": "https://issuer.example.com" },
    "oidcClientId": { "value": "replace-with-oidc-client-id" },
    "oauthAllowedEmailDomains": { "value": "replace-with-allowed-domain-or-*" },
    "oidcClientSecret": { "value": "replace-with-oidc-client-secret" },
    "oauthCookieSecret": { "value": "replace-with-32-byte-base64-cookie-secret" },
    "postgresAdminPassword": { "value": "replace-with-a-unique-database-password" },
    "jwtKey": { "value": "replace-with-a-unique-random-key-of-at-least-32-characters" }
  }
}
