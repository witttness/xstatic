<!-- ===== FAQ ===== -->
<section class="py-20 max-w-3xl mx-auto px-6">
  <h2 class="text-xl font-bold text-zinc-50 mb-10 text-center">Frequently Asked Questions</h2>

  <div class="space-y-0 divide-y divide-zinc-800 border-y border-zinc-800">

    {%- set faqs = [
      {
        q: "What happens if I exceed my plan limits?",
        a: "We'll notify you by email when you approach a limit. Your App keeps working — we won't suddenly stop accepting requests. You'll have a grace period to upgrade before any restrictions kick in."
      },
      {
        q: "Can I upgrade or downgrade at any time?",
        a: "Yes. Upgrades take effect immediately. Downgrades take effect at the end of your current billing period."
      },
      {
        q: "Is there a trial for Pro or Team?",
        a: "Every plan starts with a 14-day free trial with full access to Pro features. No credit card required to start."
      },
      {
        q: "Do you offer refunds?",
        a: "If you're not happy in the first 30 days, contact us and we'll sort it out."
      },
      {
        q: "What counts as an 'Item'?",
        a: "An Item is a single JSON document stored in a Collection. A blog comment, a contact form submission, a user rating — each is one Item."
      },
      {
        q: "Can I use Extatic for private / internal apps?",
        a: "Yes. CORS origin restrictions and API key protection mean only your allowlisted domains can call the Client API. Dashboard access is behind OAuth login."
      }
    ] %}

    {%- for faq in faqs %}
    <details class="group py-5 cursor-pointer list-none">
      <summary class="flex items-center justify-between gap-4 text-sm font-medium text-zinc-200 hover:text-zinc-50 transition-colors list-none select-none">
        {{ faq.q }}
        <svg width="16" height="16" class="shrink-0 text-zinc-500 group-open:rotate-45 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 5v14M5 12h14" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </summary>
      <p class="mt-3 text-sm text-zinc-400 leading-relaxed">{{ faq.a }}</p>
    </details>
    {%- endfor %}

  </div>
</section>


