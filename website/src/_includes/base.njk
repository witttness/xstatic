<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% if title %}{{ title }} — {% endif %}Extatic</title>
  <meta name="description" content="{{ description or 'The backend for your static site. Add structured data, user auth, file uploads, and webhooks — no server required.' }}" />
  <meta property="og:title" content="{% if title %}{{ title }} — {% endif %}Extatic" />
  <meta property="og:description" content="{{ description or 'The backend for your static site.' }}" />
  <meta property="og:url" content="https://extatic.io{{ page.url }}" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/style.css" />
</head>
<body class="bg-zinc-950 text-zinc-100 font-sans min-h-screen flex flex-col">
  {% include "nav.njk" %}
  <main class="flex-1">
    {{ content | safe }}
  </main>
  {% include "footer.njk" %}
</body>
</html>
