    <!-- QUICKSTART -->
    <section id="quickstart" class="mb-16 scroll-mt-20">
      <h2 class="text-xl font-bold text-zinc-50 mb-2">Quickstart</h2>
      <p class="text-zinc-400 mb-6 text-sm">Post an item to a collection from a plain HTML page in under 5 minutes.</p>

      <div class="space-y-8">

        <!-- Step 1 -->
        <div>
          <div class="flex items-center gap-3 mb-3">
            <span class="w-6 h-6 bg-indigo-600/20 border border-indigo-600/40 text-indigo-400 text-xs font-bold flex items-center justify-center shrink-0">1</span>
            <h3 class="text-sm font-semibold text-zinc-200">Create an App</h3>
          </div>
          <p class="text-sm text-zinc-400 mb-3 ml-9">Sign in at <code class="text-xs bg-zinc-800 px-1 py-0.5 rounded text-zinc-300">app.extatic.io</code>, click <strong class="text-zinc-300">New App</strong>, choose a name and slug. Copy the API key shown — it's only displayed once.</p>
        </div>

        <!-- Step 2 -->
        <div>
          <div class="flex items-center gap-3 mb-3">
            <span class="w-6 h-6 bg-indigo-600/20 border border-indigo-600/40 text-indigo-400 text-xs font-bold flex items-center justify-center shrink-0">2</span>
            <h3 class="text-sm font-semibold text-zinc-200">Create a Collection</h3>
          </div>
          <p class="text-sm text-zinc-400 mb-3 ml-9">Inside your App, click <strong class="text-zinc-300">New Collection</strong>. Give it the slug <code class="text-xs bg-zinc-800 px-1 py-0.5 rounded text-zinc-300">messages</code>. Leave the schema empty for now.</p>
        </div>

        <!-- Step 3 -->
        <div>
          <div class="flex items-center gap-3 mb-3">
            <span class="w-6 h-6 bg-indigo-600/20 border border-indigo-600/40 text-indigo-400 text-xs font-bold flex items-center justify-center shrink-0">3</span>
            <h3 class="text-sm font-semibold text-zinc-200">Post your first Item</h3>
          </div>
          <p class="text-sm text-zinc-400 mb-3 ml-9">Call the Client API from your site. Replace <code class="text-xs bg-zinc-800 px-1 py-0.5 rounded text-zinc-300">YOUR_API_KEY</code> with the key from step 1.</p>
          <div class="bg-zinc-900 border border-zinc-800 overflow-hidden">
            <div class="px-4 py-2 border-b border-zinc-800 text-xs font-mono text-zinc-500">JavaScript</div>
            <pre class="p-5 text-xs font-mono leading-6 text-zinc-300 overflow-x-auto"><code><span class="tok-keyword">const</span> res = <span class="tok-keyword">await</span> <span class="tok-fn">fetch</span>(
  <span class="tok-string">'https://api.extatic.io/api/client'</span>
    + <span class="tok-string">'/collections/messages/items'</span>,
  {
    method<span class="tok-punct">:</span> <span class="tok-string">'POST'</span>,
    headers<span class="tok-punct">:</span> {
      <span class="tok-string">'X-App-Id'</span><span class="tok-punct">:</span> <span class="tok-string">'YOUR_APP_ID'</span>,
      <span class="tok-string">'Content-Type'</span><span class="tok-punct">:</span> <span class="tok-string">'application/json'</span>,
    },
    body<span class="tok-punct">:</span> <span class="tok-fn">JSON.stringify</span>({ text<span class="tok-punct">:</span> <span class="tok-string">'Hello, Extatic!'</span> }),
  }
);

<span class="tok-keyword">const</span> { item } = <span class="tok-keyword">await</span> res.<span class="tok-fn">json</span>();
console.<span class="tok-fn">log</span>(item.id); <span class="tok-comment">// → UUID</span>
</code></pre>
          </div>
        </div>

        <!-- Step 4 -->
        <div>
          <div class="flex items-center gap-3 mb-3">
            <span class="w-6 h-6 bg-indigo-600/20 border border-indigo-600/40 text-indigo-400 text-xs font-bold flex items-center justify-center shrink-0">4</span>
            <h3 class="text-sm font-semibold text-zinc-200">Read it back</h3>
          </div>
          <div class="bg-zinc-900 border border-zinc-800 overflow-hidden">
            <div class="px-4 py-2 border-b border-zinc-800 text-xs font-mono text-zinc-500">GET items</div>
            <pre class="p-5 text-xs font-mono leading-6 text-zinc-300 overflow-x-auto"><code><span class="tok-keyword">const</span> { items } = <span class="tok-keyword">await</span> <span class="tok-fn">fetch</span>(
  <span class="tok-string">'https://api.extatic.io/api/client'</span>
    + <span class="tok-string">'/collections/messages/items'</span>,
  {
    headers<span class="tok-punct">:</span> { <span class="tok-string">'X-App-Id'</span><span class="tok-punct">:</span> <span class="tok-string">'YOUR_APP_ID'</span> },
  }
).<span class="tok-fn">then</span>(r <span class="tok-punct">=&gt;</span> r.<span class="tok-fn">json</span>());

items.<span class="tok-fn">forEach</span>(i <span class="tok-punct">=&gt;</span> console.<span class="tok-fn">log</span>(i.data.text));
</code></pre>
          </div>
        </div>

      </div>
    </section>

    <hr class="border-zinc-800 mb-16" />

    <!-- AUTHENTICATION -->
    <section id="authentication" class="mb-16 scroll-mt-20">
      <h2 class="text-xl font-bold text-zinc-50 mb-2">Authentication</h2>
      <p class="text-sm text-zinc-400 mb-6">Extatic has two authentication surfaces.</p>

      <div class="space-y-6">
        <div class="border border-zinc-800 bg-zinc-900/40 p-5">
          <h3 class="text-sm font-semibold text-zinc-200 mb-2">Platform API (dashboard users)</h3>
          <p class="text-sm text-zinc-500 leading-relaxed">
            Platform users (you, the developer) authenticate via OAuth2. The dashboard handles this automatically. All Platform API calls go to <code class="text-xs bg-zinc-800 px-1 py-0.5 rounded text-zinc-300">/api/apps/...</code> and require a session cookie.
          </p>
        </div>
        <div class="border border-zinc-800 bg-zinc-900/40 p-5">
          <h3 class="text-sm font-semibold text-zinc-200 mb-2">Client API (your site's users)</h3>
          <p class="text-sm text-zinc-500 leading-relaxed mb-3">
            All Client API calls require the <code class="text-xs bg-zinc-800 px-1 py-0.5 rounded text-zinc-300">X-App-Id</code> header to identify your App. This is your public App ID — safe to embed in client-side code. Endpoints that write data or return private items also require a JWT in the <code class="text-xs bg-zinc-800 px-1 py-0.5 rounded text-zinc-300">Authorization: Bearer &lt;token&gt;</code> header. The JWT is issued after a successful AppUser OAuth login.
          </p>
          <pre class="bg-zinc-900 border border-zinc-800 p-4 text-xs font-mono text-zinc-300 overflow-x-auto"><code>X-App-Id: app_a3f7b2c1d4e56f78
Authorization: Bearer eyJhbGciOiJSUzI1NiIsInR5cCI6...</code></pre>
        </div>
      </div>
    </section>

    <hr class="border-zinc-800 mb-16" />

    <!-- ERRORS -->
    <section id="errors" class="mb-16 scroll-mt-20">
      <h2 class="text-xl font-bold text-zinc-50 mb-2">Errors</h2>
      <p class="text-sm text-zinc-400 mb-6">All errors return JSON with a consistent shape.</p>
      <div class="bg-zinc-900 border border-zinc-800 overflow-hidden mb-6">
        <pre class="p-5 text-xs font-mono leading-6 text-zinc-300 overflow-x-auto"><code><span class="tok-punct">{</span>
  <span class="tok-string">"error"</span><span class="tok-punct">:</span>   <span class="tok-string">"validation_failed"</span>,
  <span class="tok-string">"message"</span><span class="tok-punct">:</span> <span class="tok-string">"Item data failed schema validation."</span>,
  <span class="tok-string">"details"</span><span class="tok-punct">:</span> [
    <span class="tok-punct">{</span>
      <span class="tok-string">"path"</span><span class="tok-punct">:</span>    <span class="tok-string">"/rating"</span>,
      <span class="tok-string">"message"</span><span class="tok-punct">:</span> <span class="tok-string">"Value 10 exceeds maximum of 5."</span>
    <span class="tok-punct">}</span>
  ]
<span class="tok-punct">}</span>
</code></pre>
      </div>
      <div class="border border-zinc-800 overflow-hidden">
        <table class="w-full text-xs">
          <thead><tr class="border-b border-zinc-800 bg-zinc-900/60">
            <th class="px-4 py-2 text-left font-medium text-zinc-400 uppercase tracking-wider">Status</th>
            <th class="px-4 py-2 text-left font-medium text-zinc-400 uppercase tracking-wider">Meaning</th>
          </tr></thead>
          <tbody class="divide-y divide-zinc-800">
            {%- set codes = [
              ["400", "Bad request — malformed JSON or missing field"],
              ["401", "Not authenticated — missing or invalid token"],
              ["403", "Forbidden — insufficient permissions or feature disabled"],
              ["404", "Resource not found"],
              ["413", "Payload too large — file exceeds size limit"],
              ["422", "Validation error — schema check failed (see details array)"],
              ["429", "Rate limit exceeded"],
              ["500", "Internal server error"]
            ] %}
            {%- for code in codes %}
            <tr class="bg-zinc-950">
              <td class="px-4 py-2.5 font-mono text-zinc-300">{{ code[0] }}</td>
              <td class="px-4 py-2.5 text-zinc-500">{{ code[1] }}</td>
            </tr>
            {%- endfor %}
          </tbody>
        </table>
      </div>
    </section>

    <hr class="border-zinc-800 mb-16" />

    <!-- API REFERENCE -->
    <section id="api" class="mb-16 scroll-mt-20">
      <h2 class="text-xl font-bold text-zinc-50 mb-2">Full API Reference</h2>
      <p class="text-sm text-zinc-400 mb-6">
        The full OpenAPI reference is auto-generated from the API itself and available at:
      </p>
      <div class="bg-zinc-900 border border-zinc-800 p-5 font-mono text-sm text-indigo-400">
        https://api.extatic.io/swagger
      </div>
      <p class="text-xs text-zinc-600 mt-3">You can also import the OpenAPI spec into Postman, Insomnia, or any REST client.</p>
    </section>

    <!-- Quick endpoint listing -->
    <section id="apps" class="mb-16 scroll-mt-20">
      <h2 class="text-xl font-bold text-zinc-50 mb-6">Endpoint Overview</h2>
      <div class="space-y-1">
        {%- set endpoints = [
          ["GET",    "/api/auth/me",                                          "Current user profile"],
          ["GET",    "/api/apps",                                             "List your Apps"],
          ["POST",   "/api/apps",                                             "Create an App"],
          ["GET",    "/api/apps/:slug",                                       "Get App details"],
          ["PUT",    "/api/apps/:slug",                                       "Update an App"],
          ["DELETE", "/api/apps/:slug",                                       "Delete an App"],
          ["GET",    "/api/apps/:slug/collections",                           "List Collections"],
          ["POST",   "/api/apps/:slug/collections",                           "Create a Collection"],
          ["GET",    "/api/apps/:slug/collections/:col",                      "Get Collection"],
          ["PUT",    "/api/apps/:slug/collections/:col",                      "Update Collection"],
          ["DELETE", "/api/apps/:slug/collections/:col",                      "Delete Collection"],
          ["GET",    "/api/apps/:slug/appusers",                              "List AppUsers"],
          ["GET",    "/api/apps/:slug/webhooks",                              "List Webhooks"],
          ["POST",   "/api/apps/:slug/webhooks",                              "Create a Webhook"],
          ["POST",   "/api/client/auth/:provider",                            "Initiate AppUser OAuth"],
          ["GET",    "/api/client/auth/:provider/callback",                   "OAuth callback"],
          ["GET",    "/api/client/collections/:col/items",                    "List Items"],
          ["POST",   "/api/client/collections/:col/items",                    "Create an Item"],
          ["GET",    "/api/client/collections/:col/items/:id",                "Get an Item"],
          ["PUT",    "/api/client/collections/:col/items/:id",                "Update an Item"],
          ["DELETE", "/api/client/collections/:col/items/:id",                "Delete an Item"],
          ["POST",   "/api/client/collections/:col/items/:id/attachments",    "Upload Attachment"],
          ["GET",    "/api/client/collections/:col/items/:id/attachments",    "List Attachments"],
          ["DELETE", "/api/client/collections/:col/items/:id/attachments/:a", "Delete Attachment"]
        ] %}
        {%- for ep in endpoints %}
        <div class="flex items-start gap-3 py-2.5 border-b border-zinc-800/50 text-xs font-mono">
          <span class="shrink-0 w-14 text-right {% if ep[0] == 'GET' %}text-sky-400{% elif ep[0] == 'POST' %}text-emerald-400{% elif ep[0] == 'PUT' %}text-yellow-400{% else %}text-red-400{% endif %} font-semibold">
            {{ ep[0] }}
          </span>
          <span class="text-zinc-300 flex-1 break-all">{{ ep[1] }}</span>
          <span class="text-zinc-600 hidden sm:block shrink-0 max-w-[180px]">{{ ep[2] }}</span>
        </div>
        {%- endfor %}
      </div>
    </section>

  </div>
</div>
