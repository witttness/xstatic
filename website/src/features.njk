<!-- ===== Collections & Schema ===== -->
<section class="py-20 max-w-6xl mx-auto px-6">
  <div class="grid md:grid-cols-2 gap-14 items-start">
    <div>
      <div class="w-10 h-10 bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center mb-6">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-indigo-400" aria-hidden="true">
          <ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <h2 class="text-xl font-bold text-zinc-50 mb-4">Collections &amp; Schema Validation</h2>
      <p class="text-zinc-400 leading-relaxed mb-6">
        A Collection is a named bucket of JSON documents — like a table, but schemaless by default. Add a JSON Schema (draft 2020-12) to enforce shape. Every submission is validated before it's written; failures return a <code class="text-xs bg-zinc-800 px-1 py-0.5 rounded text-zinc-300">422</code> with field-level errors.
      </p>
      <ul class="space-y-3 text-sm text-zinc-400 mb-8">
        <li class="flex items-start gap-3">
          <svg width="16" height="16" class="text-indigo-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Schemaless by default — start fast, add constraints later
        </li>
        <li class="flex items-start gap-3">
          <svg width="16" height="16" class="text-indigo-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Schema updates apply to future items only — existing data is never invalidated
        </li>
        <li class="flex items-start gap-3">
          <svg width="16" height="16" class="text-indigo-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Filter, sort, and paginate Items from the API
        </li>
        <li class="flex items-start gap-3">
          <svg width="16" height="16" class="text-indigo-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Stored as PostgreSQL JSONB for fast querying
        </li>
      </ul>
    </div>
    <div class="bg-zinc-900 border border-zinc-800 overflow-hidden">
      <div class="px-4 py-3 border-b border-zinc-800 text-xs font-mono text-zinc-500">Schema example — <span class="text-zinc-400">comments collection</span></div>
      <pre class="p-5 text-xs font-mono leading-6 text-zinc-300 overflow-x-auto"><code><span class="tok-punct">{</span>
  <span class="tok-string">"type"</span><span class="tok-punct">:</span> <span class="tok-string">"object"</span>,
  <span class="tok-string">"required"</span><span class="tok-punct">:</span> [<span class="tok-string">"text"</span>, <span class="tok-string">"author"</span>],
  <span class="tok-string">"additionalProperties"</span><span class="tok-punct">:</span> <span class="tok-keyword">false</span>,
  <span class="tok-string">"properties"</span><span class="tok-punct">:</span> <span class="tok-punct">{</span>
    <span class="tok-string">"text"</span><span class="tok-punct">:</span> <span class="tok-punct">{</span>
      <span class="tok-string">"type"</span><span class="tok-punct">:</span> <span class="tok-string">"string"</span>,
      <span class="tok-string">"maxLength"</span><span class="tok-punct">:</span> <span class="tok-num">1000</span>
    <span class="tok-punct">}</span>,
    <span class="tok-string">"author"</span><span class="tok-punct">:</span> <span class="tok-punct">{</span>
      <span class="tok-string">"type"</span><span class="tok-punct">:</span> <span class="tok-string">"string"</span>
    <span class="tok-punct">}</span>,
    <span class="tok-string">"rating"</span><span class="tok-punct">:</span> <span class="tok-punct">{</span>
      <span class="tok-string">"type"</span><span class="tok-punct">:</span> <span class="tok-string">"integer"</span>,
      <span class="tok-string">"minimum"</span><span class="tok-punct">:</span> <span class="tok-num">1</span>,
      <span class="tok-string">"maximum"</span><span class="tok-punct">:</span> <span class="tok-num">5</span>
    <span class="tok-punct">}</span>
  <span class="tok-punct">}</span>
<span class="tok-punct">}</span>
</code></pre>
    </div>
  </div>
</section>

