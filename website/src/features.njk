<!-- ===== AppUser Auth ===== -->
<section class="py-20 max-w-6xl mx-auto px-6">
  <div class="grid md:grid-cols-2 gap-14 items-start">
    <div class="order-2 md:order-1 bg-zinc-900 border border-zinc-800 overflow-hidden">
      <div class="px-4 py-3 border-b border-zinc-800 text-xs font-mono text-zinc-500">Initiate OAuth login from your site</div>
      <pre class="p-5 text-xs font-mono leading-6 text-zinc-300 overflow-x-auto"><code><span class="tok-comment">// Redirect user to provider login</span>
<span class="tok-keyword">function</span> <span class="tok-fn">loginWithGitHub</span>() {
  <span class="tok-keyword">const</span> url = <span class="tok-keyword">new</span> <span class="tok-fn">URL</span>(
    <span class="tok-string">'https://api.extatic.io'</span>
      + <span class="tok-string">'/api/client/auth/github'</span>
  );
  url.searchParams.<span class="tok-fn">set</span>(<span class="tok-string">'app_id'</span>, MY_APP_ID);
  url.searchParams.<span class="tok-fn">set</span>(
    <span class="tok-string">'redirect_uri'</span>,
    window.location.href,
  );
  window.location.href = url.<span class="tok-fn">toString</span>();
}

<span class="tok-comment">// On return, grab the token from params</span>
<span class="tok-keyword">const</span> params = <span class="tok-keyword">new</span> <span class="tok-fn">URLSearchParams</span>(
  window.location.search
);
<span class="tok-keyword">const</span> token = params.<span class="tok-fn">get</span>(<span class="tok-string">'token'</span>);
</code></pre>
    </div>
    <div class="order-1 md:order-2">
      <div class="w-10 h-10 bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center mb-6">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-indigo-400" aria-hidden="true">
          <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <h2 class="text-xl font-bold text-zinc-50 mb-4">AppUser Authentication</h2>
      <p class="text-zinc-400 leading-relaxed mb-6">
        Your site's visitors are AppUsers. Extatic handles the OAuth 2.0 / OpenID Connect flow with Google, GitHub, and Facebook — then issues a JWT scoped to your App. You never store passwords or manage tokens.
      </p>
      <ul class="space-y-3 text-sm text-zinc-400">
        <li class="flex items-start gap-3">
          <svg width="16" height="16" class="text-indigo-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Providers: Google, GitHub, Facebook (more coming)
        </li>
        <li class="flex items-start gap-3">
          <svg width="16" height="16" class="text-indigo-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          AppUsers are auto-created on first login and upserted on subsequent logins
        </li>
        <li class="flex items-start gap-3">
          <svg width="16" height="16" class="text-indigo-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          AppUsers own their Items — only they can edit or delete their data by default
        </li>
        <li class="flex items-start gap-3">
          <svg width="16" height="16" class="text-indigo-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Platform owner and admins can override any AppUser's data
        </li>
      </ul>
    </div>
  </div>
</section>

